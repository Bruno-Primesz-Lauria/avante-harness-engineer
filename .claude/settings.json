{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PROJECT_DIR}/adaptadores/entrada.py\" claude_code",
            "shell": "powershell",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "databricks@claude-plugins-official": true
  }
}
